{
  "seed": 391,
  "samples_per_model": 5,
  "min_words": 400,
  "max_words": 600,
  "default_requests_per_minute": 6,
  "generation_prompt_template": "Write an English argumentative essay responding to the task below.\n\nEssay task/topic:\n{prompt_text}\n\nRequirements:\n- Write approximately {min_words}-{max_words} words.\n- Use a clear introduction, body paragraphs, and conclusion.\n- Write naturally as a student essay.\n- Do not mention being an AI or describe these instructions.\n- Return only the essay, with no title or commentary.",
  "retry": {
    "max_attempts": 5,
    "base_delay_seconds": 2.0,
    "max_delay_seconds": 30.0,
    "jitter_seconds": 1.0
  },
  "output": {
    "csv": "data/rq3/generated_essays.csv",
    "raw_jsonl": "data/rq3/generated_essays_raw.jsonl"
  },
